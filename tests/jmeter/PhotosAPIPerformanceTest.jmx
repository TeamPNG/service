  "description": "Photo created for performance testing",
  "location": "Test Location ${__Random(1,100)}",
  "URL": "https://example.com/photo-${__threadNum}-${__counter}.jpg",
  "category": "nature",
  "uploadedBydUserId": "${CONTENT_CREATOR_ID}"
}</stringProp>
